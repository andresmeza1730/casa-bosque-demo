# Ejemplo de variables de entorno para Casa Bosque.
# Copia este archivo a "../casabosque-private/.env" (FUERA de la carpeta pública) y llénalo.
# El .env real nunca se sube al repositorio.

# ── Base de datos ──
# DB_NAME y DB_USER son obligatorias: sin ellas el sistema no arranca.
DB_HOST=127.0.0.1
DB_NAME=casabosque
DB_USER=usuario_de_la_base
DB_PASS=clave_de_la_base
DB_CHARSET=utf8mb4

# ── Claves de cifrado (AES-256 para los datos personales + índice ciego del documento) ──
# Dos valores largos y aleatorios, distintos entre sí. Por ejemplo:
#   php -r "echo base64_encode(random_bytes(32));"
# Se crean UNA sola vez y no se cambian: lo que se cifró con unas claves solo se descifra con ellas.
APP_ENC_KEY=cambia-esto-por-32-bytes-aleatorios-en-base64
APP_IDX_KEY=cambia-esto-por-otros-32-bytes-aleatorios-en-base64

# ── Dirección del sitio, sin barra final ──
# Con ella el sistema sabe en qué entorno corre (producción o local).
APP_URL=http://localhost/casa-bosque-demo

# ── Copia de demostración (opcional) ──
# APP_DEMO=1 quita la obligación de activar el 2FA a los administradores, para poder probar el sistema.
# Solo funciona si APP_URL está declarada y es la de la demostración.
# APP_DEMO=1
